        <!-- Decision Tree: Scan-Profil. Der Baum (id "scan-profile") liegt in goobi_decisionTrees.xml. -->
    <property name="Scan Profile" container="0">
        <project>*</project>
        <showStep name="Metadaten anreichern" access="writeRequired"/>
        <type>decisiontree</type>
        <tree>scan-profile</tree>
        <!-- optional, schreibt zusätzlich die Ergebnis-ID und den Weg (Nachweis): -->
        <resultIdProperty>Scan Profile Id</resultIdProperty>
        <pathProperty>Scan Profile Path</pathProperty>
        <!-- optional, nur wenn die Property anders heißen soll als das Feld im Baum:
        <map field="Bit Depth" to="BitDepth"/> -->
    </property>

