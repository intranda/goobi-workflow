<?xml version="1.0" encoding="UTF-8"?>
<!-- Sample trees file (all trees live in this one file, each <decisionTree> has a unique id): [IN OPERATION - JUNE 2026] Image Output Specification Decision Tree. Target-neutral: it only knows questions, answers and
     logical field names. Which property (or later metadata) a field is written to is decided by the binding (see goobi_processProperties.xml).
     Fields set on an answer are collected along the path (a later one overrides an earlier one, <defaults> are the base).
     <goto ref> continues at the question with that id, so branches that merge are written once. -->
<decisionTrees>
  <decisionTree id="scan-profile">
    <defaults>
      <field name="Format">TIFF (LZW)</field>
    </defaults>
    <question id="type" label="Type of Item">
      <answer label="Art / Object">
        <field name="Scanner">Phase One XF iQ4 150MP or Canon r5 50MP</field>
        <question label="Is colour information paramount?" hint="Colour relevant to the interpretation of the item, e.g. colour in artworks, hand-coloured drawings, designs. Generally not text, unless faded or otherwise challenging to interpret.">
          <answer label="Yes">
            <result id="ART-COLOUR">
              <field name="Bit Depth">16</field>
              <field name="DPI">≥450 dpi</field>
              <field name="Colour">Full, Adobe RGB (1998)</field>
            </result>
          </answer>
          <answer label="No">
            <result id="ART-STD">
              <field name="Bit Depth">8</field>
              <field name="DPI">≥450 dpi</field>
              <field name="Colour">Full, Adobe RGB (1998)</field>
            </result>
          </answer>
        </question>
      </answer>
      <answer label="Bound (Under A2)">
        <question label="Is the item tightly bound? (&lt;45° movement in spine)">
          <answer label="Yes">
            <field name="Scanner">Copy Stand, Phase One XF iQ4 / iXH 150MP</field>
            <question id="bound-colour" label="Is colour information paramount?" hint="Colour relevant to the interpretation of the item, e.g. colour in artworks, hand-coloured drawings, designs. Generally not text, unless faded or otherwise challenging to interpret.">
              <answer label="Yes">
                <result id="BND-COLOUR">
                  <field name="Bit Depth">16</field>
                  <field name="DPI">≥400 dpi</field>
                  <field name="Colour">Full, Adobe RGB (1998)</field>
                </result>
              </answer>
              <answer label="No">
                <result id="BND-STD">
                  <field name="Bit Depth">8</field>
                  <field name="DPI">≥400 dpi</field>
                  <field name="Colour">Full / Gray, Adobe RGB (1998) / Gray Gamma 2.2</field>
                </result>
              </answer>
            </question>
          </answer>
          <answer label="No">
            <question label="Does the item have serious conservation considerations?">
              <answer label="Yes">
                <field name="Scanner">Copy Stand, Phase One XF iQ4 / iXH 150MP</field>
                <goto ref="bound-colour" />
              </answer>
              <answer label="No">
                <question label="Is the item modern textual material?" hint="Documents on modern office paper with well-defined printed type (typeset, typed, laser-printed) and moderate to high contrast between ink and paper.">
                  <answer label="Yes">
                    <field name="Scanner">SMA ROBOSCAN V2 (Automated Book Scanner)</field>
                    <result id="BND-MODERN">
                      <field name="Bit Depth">8</field>
                      <field name="DPI">≥300 dpi</field>
                      <field name="Colour">Full / Gray, Adobe RGB (1998) / Gray Gamma 2.2</field>
                    </result>
                  </answer>
                  <answer label="No">
                    <field name="Scanner">Atiz BookDrive MkII (Canon r5 50MP)</field>
                    <goto ref="bound-colour" />
                  </answer>
                </question>
              </answer>
            </question>
          </answer>
        </question>
      </answer>
      <answer label="Flat (Reflective)">
        <question label="Does the item have conservation handling considerations?">
          <answer label="Yes">
            <field name="Scanner">Copy Stand, Phase One XF iQ4 / iXH 150MP</field>
            <question id="refl-print" label="Is the item a print/photograph?">
              <answer label="Yes">
                <result id="REF-PRINT">
                  <field name="Bit Depth">16</field>
                  <field name="DPI">≥600 dpi</field>
                  <field name="Colour">Full, Adobe RGB (1998)</field>
                </result>
              </answer>
              <answer label="No">
                <question label="Is colour information paramount?" hint="Colour relevant to the interpretation of the item, e.g. colour in artworks, hand-coloured drawings, designs. Generally not text, unless faded or otherwise challenging to interpret.">
                  <answer label="Yes">
                    <result id="REF-COLOUR">
                      <field name="Bit Depth">16</field>
                      <field name="DPI">≥400 dpi</field>
                      <field name="Colour">Full, Adobe RGB (1998)</field>
                    </result>
                  </answer>
                  <answer label="No">
                    <result id="REF-STD">
                      <field name="Bit Depth">8</field>
                      <field name="DPI">≥400 dpi</field>
                      <field name="Colour">Full / Gray, Adobe RGB (1998) / Gray Gamma 2.2</field>
                    </result>
                  </answer>
                </question>
              </answer>
            </question>
          </answer>
          <answer label="No">
            <question label="Can the item be comfortably pressed flat?">
              <answer label="No">
                <field name="Scanner">Copy Stand, Phase One XF iQ4 / iXH 150MP</field>
                <goto ref="refl-print" />
              </answer>
              <answer label="Yes">
                <question label="Is the item over A3? (297 × 420 mm)">
                  <answer label="Yes">
                    <field name="Scanner">VERSASCAN 3650 (A0 Flatbed Scanner)</field>
                    <goto ref="refl-print" />
                  </answer>
                  <answer label="No">
                    <question label="Are there large quantities of modern textual material?" hint="Documents on modern office paper with well-defined printed type (typeset, typed, laser-printed) and moderate to high contrast between ink and paper.">
                      <answer label="Yes">
                        <field name="Scanner">Kodak Multi-sheet scanner (modern, robust material only)</field>
                        <result id="REF-BULK">
                          <field name="Bit Depth">8</field>
                          <field name="DPI">≥300 dpi</field>
                          <field name="Colour">Full / Gray, Adobe RGB (1998) / Gray Gamma 2.2</field>
                        </result>
                      </answer>
                      <answer label="No">
                        <field name="Scanner">Epson XL (A3 Flatbed Scanner)</field>
                        <goto ref="refl-print" />
                      </answer>
                    </question>
                  </answer>
                </question>
              </answer>
            </question>
          </answer>
        </question>
      </answer>
      <answer label="Flat (Transparencies)">
        <question label="Microfilm/fische?">
          <answer label="Yes">
            <field name="Scanner">STImaging Vuescan Microfilm Scanner</field>
            <result id="TRN-MICROFILM">
              <field name="Bit Depth">8 (native)</field>
              <field name="DPI">4000 dpi (calculated)</field>
              <field name="Format">TIFF (LZW compressed)</field>
              <field name="Colour">Greyscale, Grey Gamma 2.2</field>
            </result>
          </answer>
          <answer label="No">
            <question label="Is the transparency on glass?">
              <answer label="Yes">
                <field name="Scanner">Copy Stand with backlight, Phase One XF iQ4 / iXH 150MP</field>
                <question id="trn-size" label="Transparency Size?">
                  <answer label="35mm to 4&quot;x5&quot;">
                    <result id="TRN-S">
                      <field name="Bit Depth">16</field>
                      <field name="DPI">≥3000 dpi</field>
                      <field name="Colour">Full / Gray, Adobe RGB (1998) / Gray Gamma 2.2</field>
                    </result>
                  </answer>
                  <answer label="4&quot;x5&quot; to A4">
                    <result id="TRN-M">
                      <field name="Bit Depth">16</field>
                      <field name="DPI">≥1500 dpi</field>
                      <field name="Colour">Full / Gray, Adobe RGB (1998) / Gray Gamma 2.2</field>
                    </result>
                  </answer>
                  <answer label="A4+ / X-ray">
                    <result id="TRN-L">
                      <field name="Bit Depth">16</field>
                      <field name="DPI">≥400 dpi</field>
                      <field name="Colour">Full / Gray, Adobe RGB (1998) / Gray Gamma 2.2</field>
                    </result>
                  </answer>
                </question>
              </answer>
              <answer label="No">
                <question label="Can the item be comfortably pressed flat?">
                  <answer label="No">
                    <field name="Scanner">Copy Stand with backlight, Phase One XF iQ4 / iXH 150MP</field>
                    <goto ref="trn-size" />
                  </answer>
                  <answer label="Yes">
                    <question label="Is the item over A3? (297 × 420 mm)">
                      <answer label="Yes">
                        <field name="Scanner">Copy Stand with backlight, Phase One XF iQ4 / iXH 150MP</field>
                        <goto ref="trn-size" />
                      </answer>
                      <answer label="No">
                        <field name="Scanner">Epson XL or Perfection flatbed with film mount</field>
                        <goto ref="trn-size" />
                      </answer>
                    </question>
                  </answer>
                </question>
              </answer>
            </question>
          </answer>
        </question>
      </answer>
    </question>
  </decisionTree>
</decisionTrees>
